{
  "name": "claude-deck",
  "version": "1.0.0",
  "description": "Desktop workbench for Claude Code: projects, sessions, terminals and graphify graphs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "dist": "electron-builder"
  },
  "author": "Claude Deck",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  },
  "productName": "Claude Deck",
  "build": {
    "appId": "local.claude-deck",
    "productName": "Claude Deck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Claude Deck"
    }
  }
}
